<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floatingRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="#DD0B0F14"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/tvDragHandle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingEnd="10dp"
        android:text="⋮⋮ CueSight"
        android:textColor="#E2E8F0"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnLockToggle"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:backgroundTint="#38BDF8"
        android:minWidth="0dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="LOCK"
        android:textColor="#0B0F14"
        android:textSize="11sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnCloseOverlay"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_marginStart="6dp"
        android:backgroundTint="#334155"
        android:minWidth="0dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="Close"
        android:textColor="#F8FAFC"
        android:textSize="11sp" />

</LinearLayout>
